{
  "name": "khmer-google-2fa-vercel",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:frontend\"",
    "dev:api": "tsx watch api/server.ts",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "start": "tsx api/server.ts",
    "generate:key": "node scripts/generate-key.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "google-auth-library": "^10.5.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3"
  },
  "engines": {
    "node": ">=20"
  }
}
