# Database: use a hosted PostgreSQL database such as Neon or Supabase.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Must exactly match the Google OAuth authorized redirect URI.
# Local: http://localhost:3001/api/auth/google/callback
# Vercel: https://YOUR-DOMAIN.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Public application URL.
APP_URL=http://localhost:5173

# 32-byte AES key in hex. Generate with: npm run generate:key
MASTER_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS

# Session cookie settings.
COOKIE_DOMAIN=
NODE_ENV=development
